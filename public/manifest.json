{
  "manifest_version": 3,

  "name": "F95 Highlighter",
  "description": "Highlights downloaded games, comics, and animations on f95zone's \"Latest Updates\" page.",
  "version": "1.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  
  "action": {
    "default_title": "Extension action title",
    "default_popup": "popup/index.html"
  },
    
  "background": {
    "service_worker": "background.js"
  },
  
  "permissions": [
    "tabs",
    "cookies",
    "storage",
    "unlimitedStorage"
  ],

  "content_scripts": [
    {
      "matches": ["https://f95zone.to/sam/latest_alpha/*"],
      "js": ["latestUpdates.js"]
    }, {
      "matches": ["https://f95zone.to/threads/*"],
      "js": ["threadPage.js"]
    }
  ],
  
  "host_permissions": [
      "*://*/*.f95zone.to/"
  ]
}
